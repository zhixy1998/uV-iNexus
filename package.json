    "lint:stylefix": "stylelint src/**/*.{less,css,vue} --fix",
    "format": "prettier --write src/",
    "rebuild": "electron-rebuild -f -w ffi-napi,ref-napi",
    "unit": "pnpm format && pnpm lint:fix && pnpm type-check && git add ."
